{
  "name": "cryptopulse-v4",
  "version": "0.1.0",
  "private": true,
  "description": "CryptoPulse V4 — deterministic crypto intelligence terminal (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute cryptopulse-v4 --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute cryptopulse-v4 --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
